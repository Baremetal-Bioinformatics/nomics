// x86 cloud box (8x RTX PRO 6000: 240 vCPU, 708 GB) for reference runs.
// Per-task caps match the Spark's (spark.config) so task resources, and with
// them fastp's per-thread chunking, are the same as in the arm64 goldens;
// Nextflow still runs many tasks at once across the 240 CPUs.
process.resourceLimits = [cpus: 20, memory: 100.GB, time: 48.h]
executor { name = 'local'; cpus = 236; memory = 680.GB }

// Spark (GB10, 20 cores, 121 GB) resource caps for reference runs.
process.resourceLimits = [cpus: 20, memory: 100.GB, time: 48.h]
docker.runOptions = '-u 1000:1000'

// sarek's GATK modules use a gatk4+gcnvkernel conda env that cannot be built for
// arm64 (gcnvkernel 0.9 requires blas=*=mkl). The arm64 profile uses
// wave.strategy='conda,container', so override the conda spec, not the container:
// Wave then builds a frozen gatk4-only arm64 image with identical tool versions.
process {
    withName: 'GATK4_.*' { conda = 'bioconda::gatk4=4.6.2.0 bioconda::htslib=1.21 bioconda::samtools=1.21' }
}

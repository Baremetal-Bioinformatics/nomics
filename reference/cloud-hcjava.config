// Overlay for x86 reference runs: HaplotypeCaller with the Java PairHMM, Java
// Smith-Waterman and HotSpot's LIBM intrinsics off, which makes x86 GATK
// match arm64 GATK record for record (docs/REFERENCE-VARIABILITY.md). The
// args are sarek 3.10.0's own (conf/modules/haplotypecaller.config) plus the
// two implementation flags.
process {
    withName: 'GATK4_HAPLOTYPECALLER' {
        ext.args = { [
            params.joint_germline       ? "-ERC GVCF"                                        : "",
            params.gatk_pcr_indel_model ? "--pcr-indel-model ${params.gatk_pcr_indel_model}" : "",
            "--pair-hmm-implementation LOGLESS_CACHING --smith-waterman JAVA",
        ].join(" ").trim() }
        containerOptions = '-e JAVA_TOOL_OPTIONS="-XX:+UnlockDiagnosticVMOptions -XX:-UseLibmIntrinsic"'
    }
}

// sarek 3.10.0 with nomics substituted for its tools: the shim directory (nomics under the
// names fastp, bwa, gatk and samtools) goes first on PATH inside every task container.
// Each shim runs nomics' own implementation when it supports the whole command line and
// otherwise execs the real tool, which is still in the image (docs/strategy/nfcore-dropin.md).
// NOMICS_SHIM_BIN must be a directory under a path Nextflow mounts into the containers
// (it mounts the volume holding the work directory). Use: scripts/nfcore/dropin_run.sh.
includeConfig 'spark.config'
env.PATH = "${System.getenv('NOMICS_SHIM_BIN')}:\$PATH"

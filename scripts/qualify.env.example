# Template for the gate machine's qualification environment. Copy it outside the
# repository, fill in the paths, and run:
#
#   NOMICS_QUALIFY_ENV=/path/to/qualify.env scripts/qualify.sh /path/to/evidence
#
# qualify.sh reads the file before it builds, exports every variable in it, and records
# the file's sha256 in report.txt. With every line filled in, a qualification run should
# report no skipped fixture decision. Lines are plain shell assignments.

# Build and test settings
NOMICS_QUALIFY_FEATURES=nomics/cuda     # leave empty for the CPU build
TMPDIR=/path/to/scratch                 # must be visible to any containerised tool below
# Debug-profile tests with optimisation: the Mutect2 goldens take over an hour each without
# it. Overflow checks and debug assertions stay on.
CARGO_PROFILE_DEV_OPT_LEVEL=2
CARGO_PROFILE_DEV_OVERFLOW_CHECKS=true
CARGO_PROFILE_DEV_DEBUG_ASSERTIONS=true

# nf-core/rnaseq test profile outputs (featureCounts and Salmon gates)
NOMICS_RNASEQ_FIXTURE=/path/to/fixtures/rnaseq-test
# Salmon alignment mode, human IU library
NOMICS_SALMON_IU_FIXTURE=/path/to/fixtures/salmon-iu
# STARsolo PBMC 1k; the directory holds an ORACLE-READY marker
NOMICS_SOLO_FIXTURE=/path/to/fixtures/starsolo-pbmc1k
# A Subread 2.1.1 featureCounts executable (`featureCounts -v` must print v2.1.1)
NOMICS_FEATURECOUNTS_ORACLE=/path/to/featureCounts
# Directory with header.ours_recal.txt and header.ref_recal.txt from the 30x CRAM gate.
# It must be a dump whose "ours" header is the BAM-mode merge of the 21 groups (the test
# derives the reference's IDs from it); a dump from a run that already wrote the merged
# CRAM header does not fit.
NOMICS_CLOUD_RECAL_GATE=/path/to/fixtures/cloud-recal-gate
# A golden HaplotypeCaller VCF and the dbSNP file it was annotated with
NOMICS_GOLDEN_VCF=/path/to/golden/HG002_WES.haplotypecaller.vcf.gz
NOMICS_DBSNP=/path/to/dbsnp_146.hg38.vcf.gz
# Java dumps from the unmodified GATK jar (reference/oracle/mutect2/):
# run_oracle.sh: <prefix>.activity.tsv, <prefix>.reads.tsv, <prefix>.prepared.bin
NOMICS_M2_ORACLE_PREFIX=/path/to/fixtures/m2-oracle/dump
# run_assembly_oracle.sh and run_likelihood_oracle.sh: one chr21 dump file each
NOMICS_M2_ASSEMBLY_ORACLE=/path/to/fixtures/m2-oracle/assembly.assembly.tsv
NOMICS_M2_LIKELIHOODS_ORACLE=/path/to/fixtures/m2-oracle/likelihood.likelihoods.tsv
# run_calls_oracle.sh for every slice the test visits (chr21 chr22 chr19 chr20 chr13
# chr16 chr12): a directory of <contig>.calls.tsv and <contig>.calls.tsv.annotations.tsv
NOMICS_M2_CALLS_ORACLE=/path/to/fixtures/m2-oracle/calls
# A featureCounts wrapper must report itself under the path it was started with
# (the table header records argv[0]); see the note in docs/GATES.md.
